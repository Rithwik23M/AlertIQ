# ============================================================================ #
# AlertIQ — Environment Variable Reference
# ============================================================================ #
#
# Copy this file to .env for local development:
#
#   cp .env.example .env
#
# NEVER commit .env to version control.
# .env is already listed in .gitignore.
#
# In production (Cloud Run), set these via the Cloud Run YAML or
# `gcloud run services update --set-env-vars` — never as plaintext secrets.
# True secrets (API keys, DB passwords) go in Google Secret Manager and are
# referenced from Cloud Run as secretKeyRef.
#
# ============================================================================ #


# ─────────────────────────────────────────────── Application ── #

# Environment name (development | staging | production).
# Controls log verbosity and certain operational defaults.
ALERTIQ_ENV=development

# Minimum log level emitted to stdout (DEBUG | INFO | WARNING | ERROR).
ALERTIQ_LOG_LEVEL=INFO

# Number of uvicorn worker processes.
# Set to 1 in containers (Cloud Run scales horizontally, not via workers).
# For local development, 1 is sufficient.
ALERTIQ_WORKERS=1


# ─────────────────────────────────────────────── Model registry ── #

# Path to the directory that holds trained model artifacts.
# Created by scripts/train_and_serialize.py.
# Example:  /app/model_registry     (inside Docker)
#           ./model_registry         (local development)
ALERTIQ_REGISTRY_PATH=./model_registry


# ─────────────────────────────────────────────── Audit logging ── #

# Destination for the structured audit trail.
#
#   ""    (empty)  → write to Python root logger (no file IO; safe for CI)
#   "-"            → write to stdout as newline-delimited JSON
#   "/path/to/audit.jsonl"
#                  → append to that file; the directory must exist
#
# In Cloud Run, use "" or "-" and rely on Cloud Logging to ingest stdout.
ALERTIQ_AUDIT_LOG_PATH=


# ─────────────────────────────────────────────── Serving ── #

# Bind address for the uvicorn HTTP server.
# Cloud Run injects PORT=8080 automatically; this variable is only needed
# for local overrides.
ALERTIQ_HOST=0.0.0.0
ALERTIQ_PORT=8080

# Maximum request body size in bytes.
# Default 1 MB (1_048_576).  Increase cautiously: large batches increase
# memory pressure.
ALERTIQ_MAX_BODY_BYTES=1048576


# ─────────────────────────────────────────────── (no secrets here) ── #
#
# AlertIQ does not currently require any external API keys, database
# credentials, or other secret values.
#
# If you add integrations that require secrets, store them in Google Secret
# Manager and reference them as secretKeyRef in the Cloud Run service YAML.
# Do NOT add secret values to this file or to any file committed to git.
#
